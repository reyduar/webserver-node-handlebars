<section id="post" class="wrapper bg-img" data-bg="{{post.image}}">
	<div class="inner">
		<article class="box">
			<header>
				<h2>{{post.title}}</h2>
				<p>{{formatDate post.date}}</p>
			</header>
			<div class="content">
				{{#each post.body}}
					<p>{{this}}</p>
				{{/each}}
			</div>
			<footer>
				<ul class="actions">
					<li><a href="/" class="button alt icon fa-chevron-left"><span class="label">Volver al inicio</span></a></li>
				</ul>
			</footer>
		</article>
	</div>
</section>
